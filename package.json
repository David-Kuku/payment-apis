{
  "name": "payment-app",
  "version": "1.0.0",
  "description": "A Stripe-like payment platform, built to learn senior backend engineering.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/tracing.ts src/index.ts",
    "worker": "tsx watch --import ./src/tracing.ts src/webhook-worker.ts",
    "worker:logs": "docker compose logs -f worker",
    "rabbit:setup": "tsx src/webhooks/rabbit/setup.ts",
    "rabbit:setup:docker": "docker compose exec app npm run rabbit:setup",
    "rabbit:worker": "tsx watch --import ./src/tracing.ts src/rabbit-worker.ts",
    "settlement:worker": "tsx watch --import ./src/tracing.ts src/settlement-worker.ts",
    "rabbit:worker:logs": "docker compose logs -f rabbit-worker",
    "migrate": "tsx src/migrate.ts",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f app",
    "migrate:docker": "docker compose exec app npm run migrate",
    "seed": "tsx src/seed.ts",
    "seed:docker": "docker compose exec app npm run seed",
    "pretest": "tsx src/test/prepare-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "docker compose exec app npm test",
    "attack": "tsx src/attack.ts",
    "attack:docker": "docker compose exec app npm run attack",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
